<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\Branding.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.18362.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateTemporaryStoreCertificate>false</GenerateTemporaryStoreCertificate>

    <AssemblyName>$(BrandExeName)</AssemblyName>
    <RootNamespace>Typedown.WinUI</RootNamespace>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Typedown.WinUI.Program</StartupObject>
    <Configurations>Debug;Release;Debug_Local</Configurations>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseRidGraph>true</UseRidGraph>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <WindowsAppSdkBootstrapInitialize>true</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSDKBootstrapAutoInitializeOptions_OnPackageIdentity_NoOp>true</WindowsAppSDKBootstrapAutoInitializeOptions_OnPackageIdentity_NoOp>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <SelfContained>true</SelfContained>

    <!-- Native AOT and trimming are deliberately deferred until feature parity is established. -->
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'ARM64'">
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <AppxBundlePlatforms>arm64</AppxBundlePlatforms>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);MODE_DEBUG</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug_Local'">
    <DefineConstants>$(DefineConstants);MODE_DEBUG_LOCAL</DefineConstants>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>$(DefineConstants);MODE_RELEASE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <ProjectReference Include="..\Typedown.Contracts\Typedown.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\*.png" />
    <Content Include="Assets\logo.ico" CopyToOutputDirectory="PreserveNewest" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <PropertyGroup>
    <!-- The existing React/Muya build and CI publish here. The host consumes that immutable output. -->
    <EditorStaticBundleSource>$(MSBuildThisFileDirectory)..\Typedown\Resources\Statics</EditorStaticBundleSource>
    <EditorStaticBundleTarget>Resources\Statics</EditorStaticBundleTarget>
  </PropertyGroup>

  <Target
    Name="RefreshEditorStaticBundle"
    BeforeTargets="AssignTargetPaths;GetCopyToOutputDirectoryItems;GetPackagingOutputs">
    <Error
      Condition="('$(Configuration)' == 'Release' Or '$(Configuration)' == 'Debug_Local') And !Exists('$(EditorStaticBundleSource)\index.html')"
      Text="The Typedown.Editor static bundle is missing. Build Dev\Typedown.Editor before building Typedown.WinUI." />
  </Target>

  <!-- Evaluate generated files once per build. A target may run more than once during MSIX publishing. -->
  <ItemGroup Condition="Exists('$(EditorStaticBundleSource)\index.html')">
    <Content Include="$(EditorStaticBundleSource)\**\*">
      <Link>$(EditorStaticBundleTarget)\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target
    Name="CleanEditorStaticBundleOutput"
    BeforeTargets="_CopyOutOfDateSourceItemsToOutputDirectoryAlways"
    Condition="'$(OutDir)' != '' And Exists('$(OutDir)$(EditorStaticBundleTarget)')">
    <RemoveDir Directories="$(OutDir)$(EditorStaticBundleTarget)" />
  </Target>

  <Target
    Name="AddEditorStaticBundleToPackagingOutputs"
    AfterTargets="GetPackagingOutputs"
    BeforeTargets="_ComputeAppxPackagePayload"
    Condition="'$(WindowsPackageType)' == 'MSIX' And Exists('$(EditorStaticBundleSource)\index.html')">
    <ItemGroup>
      <_EditorStaticBundlePackageFile Include="$(EditorStaticBundleSource)\**\*" />
      <PackagingOutputs Include="@(_EditorStaticBundlePackageFile)">
        <TargetPath>Resources\Statics\%(_EditorStaticBundlePackageFile.RecursiveDir)%(_EditorStaticBundlePackageFile.Filename)%(_EditorStaticBundlePackageFile.Extension)</TargetPath>
        <OutputGroup>CustomOutputGroupForPackaging</OutputGroup>
        <ProjectName>$(ProjectName)</ProjectName>
      </PackagingOutputs>
    </ItemGroup>
    <Message
      Importance="high"
      Text="Typedown.Editor: @(_EditorStaticBundlePackageFile->Count()) file(s) added to the $(RuntimeIdentifier) MSIX payload." />
  </Target>

  <PropertyGroup>
    <AutomationCliProject>$(MSBuildThisFileDirectory)..\..\Tools\Typedown.Cli\Typedown.Cli.csproj</AutomationCliProject>
    <AutomationCliTargetFramework>net10.0</AutomationCliTargetFramework>
    <AutomationCliPublishDirectory>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)cli-publish\$(Configuration)\$(RuntimeIdentifier)\</AutomationCliPublishDirectory>
  </PropertyGroup>

  <!--
    The stable MSIX exposes $(BrandCliName).exe from a $(BrandName) subfolder.
    Publish the CLI for the package's own .NET 10 runtime and architecture, then
    add every non-symbol output to the single-project MSIX payload.
  -->
  <Target
    Name="PublishAutomationCliForPackaging"
    AfterTargets="GetPackagingOutputs"
    BeforeTargets="_ComputeAppxPackagePayload"
    Condition="'$(WindowsPackageType)' == 'MSIX' and '$(RuntimeIdentifier)' != ''">
    <RemoveDir Directories="$(AutomationCliPublishDirectory)" />
    <MSBuild
      Projects="$(AutomationCliProject)"
      Targets="Restore"
      BuildInParallel="false"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);RuntimeIdentifiers=$(RuntimeIdentifier);SelfContained=true;TypedownWinUIPackaging=true" />
    <MSBuild
      Projects="$(AutomationCliProject)"
      Targets="Publish"
      BuildInParallel="false"
      Properties="Configuration=$(Configuration);TargetFramework=$(AutomationCliTargetFramework);RuntimeIdentifier=$(RuntimeIdentifier);RuntimeIdentifiers=$(RuntimeIdentifier);SelfContained=true;PublishSingleFile=false;PublishTrimmed=false;PublishDir=$(AutomationCliPublishDirectory);TypedownWinUIPackaging=true" />
    <ItemGroup>
      <_AutomationCliPackageFile
        Include="$(AutomationCliPublishDirectory)**\*"
        Exclude="$(AutomationCliPublishDirectory)**\*.pdb" />
      <PackagingOutputs Include="@(_AutomationCliPackageFile)">
        <TargetPath>$(BrandName)\%(_AutomationCliPackageFile.RecursiveDir)%(_AutomationCliPackageFile.Filename)%(_AutomationCliPackageFile.Extension)</TargetPath>
        <OutputGroup>CustomOutputGroupForPackaging</OutputGroup>
        <ProjectName>$(ProjectName)</ProjectName>
      </PackagingOutputs>
    </ItemGroup>
    <Error
      Condition="!Exists('$(AutomationCliPublishDirectory)$(BrandCliName).exe')"
      Text="The .NET 10 automation CLI was not published for $(RuntimeIdentifier)." />
    <Message
      Importance="high"
      Text="$(BrandCliName): @(_AutomationCliPackageFile->Count()) file(s) added to the $(RuntimeIdentifier) MSIX payload." />
  </Target>
</Project>
