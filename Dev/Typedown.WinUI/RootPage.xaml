<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Typedown.WinUI.RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="O"
            Modifiers="Control"
            Invoked="OnOpenAcceleratorInvoked" />
        <KeyboardAccelerator
            Key="S"
            Modifiers="Control"
            Invoked="OnSaveInvoked" />
    </Page.KeyboardAccelerators>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <MenuBar x:Name="ShellMenuBar">
                <MenuBarItem
                    x:Name="FileMenu"
                    AutomationProperties.AutomationId="MenuBarFileItem">
                    <MenuFlyoutItem
                        x:Name="OpenFileItem"
                        AutomationProperties.AutomationId="OpenFileItem"
                        Click="OnOpenInvoked" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Name="SaveFileItem"
                        AutomationProperties.AutomationId="SaveFileItem"
                        Click="OnSaveMenuInvoked" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Name="CloseWindowItem"
                        AutomationProperties.AutomationId="CloseWindowItem"
                        Click="OnCloseWindowInvoked" />
                </MenuBarItem>
            </MenuBar>

            <TextBlock
                x:Name="DocumentTitleText"
                Grid.Column="1"
                Margin="12,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <ContentPresenter
            x:Name="EditorPresenter"
            Grid.Row="1" />

        <Border
            x:Name="StatusBar"
            Grid.Row="2"
            Padding="10,4"
            AutomationProperties.AutomationId="StatusBar">
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="16">
                <TextBlock
                    x:Name="WordCountText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    x:Name="CharacterCountText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
