<Page
    x:Class="Typedown.Core.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Typedown.Core.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:controls="using:Typedown.Core.Controls"
    xmlns:u="using:Typedown.Core.Utilities"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">
    <Page.Resources>
        <!-- Every notice's frame (NoticeCard): one, where each card had its own copy. -->
        <Style x:Key="NoticeCardStyle" TargetType="Border">
            <Setter Property="MaxWidth" Value="560"/>
            <Setter Property="Padding" Value="16,10,8,10"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorTertiary}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefault}"/>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <controls:MainContent Grid.Row="1"/>
        <!-- Cards over the window, bottom right, one above the other (UIViewModel.Notices, drawn by NoticeCard): an
             export written, the first edit's rewrite, a copy the clipboard never took, an edition's card. -->
        <StackPanel x:Name="NoticeStack" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" Spacing="8"/>
        <controls:StatusBar x:Name="StatusBar" Grid.Row="2" x:Load="{x:Bind AppViewModel.SettingsViewModel.StatusBarOpen, Mode=OneWay}"/>
        <!-- Kept loaded (not x:Load) in full screen so its menu shortcuts (F11 included) stay registered; only collapsed. -->
        <controls:MenuBar x:Name="MenuBarHost" PointerEntered="OnMenuBarPointerEntered" PointerExited="OnMenuBarPointerExited"/>
        <!-- Full screen: resting the pointer on the very top edge reveals the hidden menu bar. Two pixels, not more:
             the tabs are right below, and a taller strip revealed the menu on the way to a tab and took their clicks. -->
        <Grid x:Name="FullScreenRevealStrip" Grid.RowSpan="3" Height="2" VerticalAlignment="Top" Background="Transparent"
              x:Load="{x:Bind AppViewModel.UIViewModel.IsFullScreen, Mode=OneWay}"
              PointerEntered="OnRevealStripPointerEntered" PointerExited="OnRevealStripPointerExited"/>
    </Grid>
</Page>
