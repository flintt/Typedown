<UserControl
    x:Class="Typedown.Core.Controls.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Typedown.Core.Controls"
    xmlns:models="using:Typedown.Core.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:u="using:Typedown.Core.Utilities"
    AutomationProperties.AutomationId="HomePage"
    Visibility="Collapsed"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">
    <!-- The home page over the editor of a blank tab (HomeViewModel). Native, not part of the editor page; the editor
         keeps the keyboard under it, so typing goes into the document and hides it. -->
    <UserControl.Resources>
        <MenuFlyout x:Key="RecentFileFlyout" Opening="OnEntryFlyoutOpening">
            <MenuFlyoutItem Tag="Favorite" AutomationProperties.AutomationId="HomeFavoriteItem" Text="{u:LocaleString Key=Favorites.Add}" Click="OnToggleFavoriteClick"/>
            <MenuFlyoutItem Tag="RemoveRecent" AutomationProperties.AutomationId="HomeRemoveRecentItem" Text="{u:LocaleString Key=HomePage.RemoveFromList}" Click="OnRemoveRecentClick"/>
            <MenuFlyoutItem Text="{u:LocaleString Key=OpenFileLocation}" Click="OnLocationClick"/>
        </MenuFlyout>
        <MenuFlyout x:Key="RecentFolderFlyout" Opening="OnEntryFlyoutOpening">
            <MenuFlyoutItem Tag="Favorite" Text="{u:LocaleString Key=Favorites.Add}" Click="OnToggleFavoriteClick"/>
            <MenuFlyoutItem Tag="RemoveRecent" Text="{u:LocaleString Key=HomePage.RemoveFromList}" Click="OnRemoveRecentClick"/>
            <MenuFlyoutItem Text="{u:LocaleString Key=OpenFileLocation}" Click="OnLocationClick"/>
        </MenuFlyout>
        <MenuFlyout x:Key="FavoriteFlyout">
            <MenuFlyoutItem Text="{u:LocaleString Key=Favorites.Remove}" Click="OnRemoveFavoriteClick"/>
            <MenuFlyoutItem Text="{u:LocaleString Key=OpenFileLocation}" Click="OnLocationClick"/>
        </MenuFlyout>

        <Style x:Key="HomeListStyle" TargetType="ListView">
            <Setter Property="SelectionMode" Value="None"/>
            <Setter Property="IsItemClickEnabled" Value="True"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,20,0,6"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>

        <DataTemplate x:Key="FileEntryTemplate" x:DataType="models:PathItem">
            <Grid ColumnSpacing="12" MinHeight="40" Padding="0,4" Background="Transparent" Opacity="{x:Bind Opacity, Mode=OneWay}"
                  ToolTipService.ToolTip="{x:Bind Path}" AutomationProperties.Name="{x:Bind Name}" AutomationProperties.HelpText="{x:Bind Path}"
                  ContextFlyout="{StaticResource RecentFileFlyout}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon FontSize="16" Glyph="{x:Bind Glyph}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{x:Bind Location}" TextTrimming="CharacterEllipsis" FontSize="12" Opacity="0.65"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{x:Bind Modified, Mode=OneWay}" FontSize="12" Opacity="0.65" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="FolderEntryTemplate" x:DataType="models:PathItem">
            <Grid ColumnSpacing="12" MinHeight="40" Padding="0,4" Background="Transparent" Opacity="{x:Bind Opacity, Mode=OneWay}"
                  ToolTipService.ToolTip="{x:Bind Path}" AutomationProperties.Name="{x:Bind Name}" AutomationProperties.HelpText="{x:Bind Path}"
                  ContextFlyout="{StaticResource RecentFolderFlyout}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon FontSize="16" Glyph="{x:Bind Glyph}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{x:Bind Location}" TextTrimming="CharacterEllipsis" FontSize="12" Opacity="0.65"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="FavoriteEntryTemplate" x:DataType="models:PathItem">
            <Grid ColumnSpacing="12" MinHeight="40" Padding="0,4" Background="Transparent" Opacity="{x:Bind Opacity, Mode=OneWay}"
                  ToolTipService.ToolTip="{x:Bind Path}" AutomationProperties.Name="{x:Bind Name}" AutomationProperties.HelpText="{x:Bind Path}"
                  ContextFlyout="{StaticResource FavoriteFlyout}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon FontSize="16" Glyph="{x:Bind Glyph}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{x:Bind Location}" TextTrimming="CharacterEllipsis" FontSize="12" Opacity="0.65"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}">
        <!-- A custom theme's background over the system's (set from code; empty without one). -->
        <Border x:Name="ThemeLayer"/>
        <!-- Where the keyboard is while the home page shows: what is typed (an input method's text too, Enter as a new
             line) collects here and goes into the blank document once the editor has it (HomePage.HandOn). Not seen;
             Tab leaves it for the page's buttons. -->
        <TextBox x:Name="TypingSink" AutomationProperties.AutomationId="HomeTypingSink" AutomationProperties.AccessibilityView="Raw"
                 Width="1" Height="1" MinWidth="0" MinHeight="0" Padding="0" BorderThickness="0" Opacity="0"
                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,90,0,0"
                 AcceptsReturn="True" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                 TextChanged="OnSinkTextChanged" Paste="OnSinkPaste"
                 TextCompositionStarted="OnSinkCompositionStarted" TextCompositionEnded="OnSinkCompositionEnded"/>
        <ScrollViewer x:Name="Scroller" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" Margin="32,32,32,24" HorizontalAlignment="Stretch">
                <TextBlock Text="{u:LocaleString Key=HomePage.Title}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16"/>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="HomeNewButton" AutomationProperties.AutomationId="HomeNewButton" Click="OnNewClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xe8a5;"/>
                            <TextBlock Text="{u:LocaleString Key=HomePage.NewDocument}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="HomeOpenFileButton" AutomationProperties.AutomationId="HomeOpenFileButton" Click="OnOpenFileClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xe8e5;"/>
                            <TextBlock Text="{u:LocaleString Key=HomePage.OpenFile}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="HomeOpenFolderButton" AutomationProperties.AutomationId="HomeOpenFolderButton" Click="OnOpenFolderClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xe838;"/>
                            <TextBlock Text="{u:LocaleString Key=HomePage.OpenFolder}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="FavoritesSection" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{u:LocaleString Key=Favorites.Title}"/>
                    <ListView x:Name="FavoritesList" AutomationProperties.AutomationId="HomeFavorites" Style="{StaticResource HomeListStyle}"
                              ItemsSource="{x:Bind FavoriteItems}" ItemTemplate="{StaticResource FavoriteEntryTemplate}" ItemClick="OnEntryClick"/>
                </StackPanel>

                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{u:LocaleString Key=HomePage.RecentFiles}"/>
                <TextBlock x:Name="NoRecentFilesText" Text="{u:LocaleString Key=NoRecentFiles}" Opacity="0.65" Visibility="Collapsed"/>
                <ListView x:Name="RecentFilesList" AutomationProperties.AutomationId="HomeRecentFiles" Style="{StaticResource HomeListStyle}"
                          ItemsSource="{x:Bind RecentFiles}" ItemTemplate="{StaticResource FileEntryTemplate}" ItemClick="OnEntryClick"/>

                <StackPanel x:Name="RecentFoldersSection" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{u:LocaleString Key=HomePage.RecentFolders}"/>
                    <ListView x:Name="RecentFoldersList" AutomationProperties.AutomationId="HomeRecentFolders" Style="{StaticResource HomeListStyle}"
                              ItemsSource="{x:Bind RecentFolders}" ItemTemplate="{StaticResource FolderEntryTemplate}" ItemClick="OnEntryClick"/>
                </StackPanel>

                <!-- An edition's own sections (EditionHooks), after the page's own. -->
                <StackPanel x:Name="EditionSections"/>

                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,24,0,0" Opacity="0.75">
                    <TextBlock x:Name="ShortcutHints" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"/>
                    <HyperlinkButton x:Name="HomeSettingsLink" AutomationProperties.AutomationId="HomeSettingsLink" Padding="4,2" FontSize="12"
                                     Content="{u:LocaleString Key=HomePage.Settings}" Click="OnSettingsClick"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
