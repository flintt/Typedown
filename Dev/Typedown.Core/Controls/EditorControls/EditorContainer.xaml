<UserControl
    x:Class="Typedown.Core.Controls.EditorContainer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Typedown.Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:float="using:Typedown.Core.Controls.FloatControls" 
    xmlns:viewmodels="using:Typedown.Core.ViewModels" 
    xmlns:items="using:Typedown.Core.Controls.EditorControls.ContextMenuItems"
    xmlns:u="using:Typedown.Core.Utilities"
    d:DataContext="{d:DesignInstance Type=viewmodels:AppViewModel}"
    mc:Ignorable="d"
    x:Name="ThisControl"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    d:DesignHeight="300"
    d:DesignWidth="400">
    <UserControl.Resources>
        <ScaleTransform 
            x:Key="FindReplaceTransform" 
            x:Name="FindReplaceTransform" 
            CenterX="{x:Bind FindReplaceCenterPoint.X, Mode=OneWay}" 
            CenterY="{x:Bind FindReplaceCenterPoint.Y, Mode=OneWay}"/>
        <CircleEase x:Key="CircleEaseOut" EasingMode="EaseOut"/>
        <CircleEase x:Key="CircleEaseIn" EasingMode="EaseIn"/>
    </UserControl.Resources>
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="FindReplaceStates">
                <VisualStateGroup.Transitions>
                    <VisualTransition To="FindReplaceVisible" GeneratedDuration="0:0:0.2">
                        <VisualTransition.Storyboard>
                            <Storyboard>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ThisControl" Storyboard.TargetProperty="IsFindReplaceLoad">
                                    <DiscreteObjectKeyFrame KeyTime="0" Value="True"/>
                                </ObjectAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FindReplaceTransform" Storyboard.TargetProperty="ScaleX">
                                    <DiscreteDoubleKeyFrame KeyTime="0" Value="0"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1" EasingFunction="{StaticResource CircleEaseOut}"/>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FindReplaceTransform" Storyboard.TargetProperty="ScaleY">
                                    <DiscreteDoubleKeyFrame KeyTime="0" Value="0"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1" EasingFunction="{StaticResource CircleEaseOut}"/>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </VisualTransition.Storyboard>
                    </VisualTransition>
                    <VisualTransition To="FindReplaceCollapsed" GeneratedDuration="0:0:0.2">
                        <VisualTransition.Storyboard>
                            <Storyboard>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ThisControl" Storyboard.TargetProperty="IsFindReplaceLoad">
                                    <DiscreteObjectKeyFrame KeyTime="0" Value="True"/>
                                </ObjectAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FindReplaceTransform" Storyboard.TargetProperty="ScaleX">
                                    <DiscreteDoubleKeyFrame KeyTime="0" Value="1"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0" EasingFunction="{StaticResource CircleEaseIn}"/>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FindReplaceTransform" Storyboard.TargetProperty="ScaleY">
                                    <DiscreteDoubleKeyFrame KeyTime="0" Value="1"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0" EasingFunction="{StaticResource CircleEaseIn}"/>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </VisualTransition.Storyboard>
                    </VisualTransition>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="FindReplaceVisible">
                    <VisualState.Setters>
                        <Setter Target="ThisControl.IsFindReplaceLoad" Value="True"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="FindReplaceCollapsed">
                    <VisualState.Setters>
                        <Setter Target="ThisControl.IsFindReplaceLoad" Value="False"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ContentPresenter x:Name="MarkdownEditorPresenter" AllowDrop="True" DragEnter="OnDragEnter" Drop="OnDrop">
            <ContentPresenter.ContextFlyout>
                <MenuFlyout x:Name="Flyout" OverlayInputPassThroughElement="{Binding XamlRoot.Content}" AreOpenCloseAnimationsEnabled="{Binding SettingsViewModel.AnimationEnable}">
                    <items:FormatItem x:Name="MenuFormatItem" x:Load="{x:Bind local:EditorContainer.IsLoadFormatMenu(Editor.ParagraphState.FormatIsEnable, Settings.ReadOnly, Settings.SourceCode), Mode=OneWay}" ItemClick="OnFormatItemClick"/>
                    <MenuFlyoutSeparator x:Name="MenuFormatItemSeparator" x:Load="{x:Bind local:EditorContainer.IsLoadFormatMenu(Editor.ParagraphState.FormatIsEnable, Settings.ReadOnly, Settings.SourceCode), Mode=OneWay}"/>
                    <MenuFlyoutSubItem x:Name="MenuImageItem" Text="{u:LocaleString Key=Image}" x:Load="{x:Bind local:EditorContainer.IsLoadImageMenu(Format.FormatState.Image, Editor.Selection), Mode=OneWay}">
                        <MenuFlyoutSubItem.Icon>
                            <FontIcon Glyph="&#xe91b;"/>
                        </MenuFlyoutSubItem.Icon>
                        <local:MenuItemCollection.Value>
                            <items:ImageItem/>
                        </local:MenuItemCollection.Value>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSeparator x:Name="MenuImageItemSeparator" x:Load="{x:Bind local:EditorContainer.IsLoadImageMenu(Format.FormatState.Image, Editor.Selection), Mode=OneWay}"/>
                    <!--<MenuFlyoutSubItem x:Name="MenuCodeFencesItem" Text="{u:LocaleString Key=CodeFences}" x:Load="{x:Bind Editor.ParagraphState.CodeFences.IsChecked, Mode=OneWay}">
                        <local:MenuItemCollection.Value>
                            <items:CodeFencesItem/>
                        </local:MenuItemCollection.Value>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSeparator x:Name="MenuCodeFencesItemSeparator" x:Load="{x:Bind Editor.ParagraphState.CodeFences.IsChecked, Mode=OneWay}"/>-->
                    <!-- Right-clicked in a table: the table copied as its copy button copies it, as a table for Word and Excel
                         and as Markdown for text (the page's ContentState.copyBlock). Shown by Visibility, not x:Load: the
                         page says where the click was as the button goes down, and an item loaded into a menu already open
                         did not show. -->
                    <!-- The object right-clicked (the page's ContextMenuTarget; the 2026-11-11 menu report): a table's own items, a
                         link's, a code block's, a formula's or a diagram's. Not in source mode, which has none of them. -->
                    <!-- Copy table at the top, one click as it was (the user, 2026-11-11); the rows and columns in the submenu. -->
                    <MenuFlyoutItem x:Name="CopyTableItem" Icon="Copy" Text="{u:LocaleString Key=CopyTable}" Command="{x:Bind Editor.CopyTableCommand}" Visibility="{x:Bind local:EditorContainer.TableMenuVisibility(Editor.ContextMenuInTable, Settings.SourceCode), Mode=OneWay}"/>
                    <MenuFlyoutSubItem x:Name="TableSubItem" Text="{u:LocaleString Key=Table}" Visibility="{x:Bind local:EditorContainer.TableEditVisibility(Editor.ContextMenuInTable, Settings.SourceCode, Settings.ReadOnly), Mode=OneWay}">
                        <MenuFlyoutItem x:Name="TableRowAboveItem" Text="{u:LocaleString Key=InsertRowAbove}" Command="{x:Bind Editor.EditTableCommand}" CommandParameter="insert-previous-row" Visibility="{x:Bind Settings.ReadOnly, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}"/>
                        <MenuFlyoutItem x:Name="TableRowBelowItem" Text="{u:LocaleString Key=InsertRowBelow}" Command="{x:Bind Editor.EditTableCommand}" CommandParameter="insert-next-row" Visibility="{x:Bind Settings.ReadOnly, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}"/>
                        <MenuFlyoutItem x:Name="TableRowRemoveItem" Text="{u:LocaleString Key=RemoveRow}" Command="{x:Bind Editor.EditTableCommand}" CommandParameter="remove-current-row" Visibility="{x:Bind Settings.ReadOnly, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}"/>
                        <MenuFlyoutSeparator Visibility="{x:Bind Settings.ReadOnly, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}"/>
                        <MenuFlyoutItem x:Name="TableColumnLeftItem" Text="{u:LocaleString Key=InsertColumnLeft}" Command="{x:Bind Editor.EditTableCommand}" CommandParameter="insert-left-column" Visibility="{x:Bind Settings.ReadOnly, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}"/>
                        <MenuFlyoutItem x:Name="TableColumnRightItem" Text="{u:LocaleString Key=InsertColumnRight}" Command="{x:Bind Editor.EditTableCommand}" CommandParameter="insert-right-column" Visibility="{x:Bind Settings.ReadOnly, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}"/>
                        <MenuFlyoutItem x:Name="TableColumnRemoveItem" Text="{u:LocaleString Key=RemoveColumn}" Command="{x:Bind Editor.EditTableCommand}" CommandParameter="remove-current-column" Visibility="{x:Bind Settings.ReadOnly, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}"/>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutItem x:Name="OpenLinkItem" Text="{u:LocaleString Key=OpenLinkItem}" Command="{x:Bind Editor.ContextMenuActionCommand}" CommandParameter="openLink" Visibility="{x:Bind local:EditorContainer.LinkMenuVisibility(Editor.ContextMenuOnLink, Settings.SourceCode, x:False), Mode=OneWay}"/>
                    <MenuFlyoutItem x:Name="CopyLinkAddressItem" Text="{u:LocaleString Key=CopyLinkAddress}" Command="{x:Bind Editor.CopyLinkAddressCommand}" Visibility="{x:Bind local:EditorContainer.LinkMenuVisibility(Editor.ContextMenuOnLink, Settings.SourceCode, x:False), Mode=OneWay}"/>
                    <MenuFlyoutItem x:Name="EditLinkItem" AutomationProperties.AutomationId="EditLinkItem" Text="{u:LocaleString Key=EditLink}" Command="{x:Bind Editor.ContextMenuActionCommand}" CommandParameter="editLink" Visibility="{x:Bind local:EditorContainer.LinkMenuVisibility(Editor.ContextMenuOnLink, Settings.SourceCode, Settings.ReadOnly), Mode=OneWay}"/>
                    <MenuFlyoutItem x:Name="RemoveLinkItem" Text="{u:LocaleString Key=RemoveLink}" Command="{x:Bind Editor.ContextMenuActionCommand}" CommandParameter="removeLink" Visibility="{x:Bind local:EditorContainer.LinkMenuVisibility(Editor.ContextMenuOnLink, Settings.SourceCode, Settings.ReadOnly), Mode=OneWay}"/>
                    <MenuFlyoutItem x:Name="CopyCodeItem" Icon="Copy" Text="{u:LocaleString Key=CopyCodeItem}" Command="{x:Bind Editor.ContextMenuActionCommand}" CommandParameter="copyCode" Visibility="{x:Bind local:EditorContainer.TableMenuVisibility(Editor.ContextMenuInCode, Settings.SourceCode), Mode=OneWay}"/>
                    <MenuFlyoutItem x:Name="CopyFormulaItem" Icon="Copy" Text="{u:LocaleString Key=CopyFormulaItem}" Command="{x:Bind Editor.ContextMenuActionCommand}" CommandParameter="copyBlock" Visibility="{x:Bind local:EditorContainer.TableMenuVisibility(Editor.ContextMenuOnMath, Settings.SourceCode), Mode=OneWay}"/>
                    <MenuFlyoutItem x:Name="CopyDiagramItem" Icon="Copy" Text="{u:LocaleString Key=CopyDiagramItem}" Command="{x:Bind Editor.ContextMenuActionCommand}" CommandParameter="copyBlock" Visibility="{x:Bind local:EditorContainer.TableMenuVisibility(Editor.ContextMenuOnDiagram, Settings.SourceCode), Mode=OneWay}"/>
                    <!-- Review mode: the revision right-clicked, accepted or rejected there, or every one from its source. -->
                    <MenuFlyoutItem x:Name="ReviewAcceptItem" Text="{u:LocaleString Key=ReviewAcceptHere}" Command="{x:Bind Editor.ContextMenuActionCommand}" CommandParameter="reviewAccept" Visibility="{x:Bind local:EditorContainer.TableMenuVisibility(Editor.ContextMenuOnRevision, Settings.SourceCode), Mode=OneWay}"/>
                    <MenuFlyoutItem x:Name="ReviewRejectItem" Text="{u:LocaleString Key=ReviewRejectHere}" Command="{x:Bind Editor.ContextMenuActionCommand}" CommandParameter="reviewReject" Visibility="{x:Bind local:EditorContainer.TableMenuVisibility(Editor.ContextMenuOnRevision, Settings.SourceCode), Mode=OneWay}"/>
                    <MenuFlyoutItem x:Name="ReviewAcceptSourceItem" Text="{u:LocaleString Key=ReviewAcceptSource}" Command="{x:Bind Editor.ContextMenuActionCommand}" CommandParameter="reviewAcceptSource" Visibility="{x:Bind local:EditorContainer.TableMenuVisibility(Editor.ContextMenuOnRevision, Settings.SourceCode), Mode=OneWay}"/>
                    <MenuFlyoutSeparator x:Name="ObjectSeparator" Visibility="{x:Bind local:EditorContainer.ObjectGroupVisibility(Editor.ContextMenuInTable, Editor.ContextMenuOnLink, Editor.ContextMenuInCode, Editor.ContextMenuOnMath, Editor.ContextMenuOnDiagram, Editor.ContextMenuOnRevision, Settings.SourceCode), Mode=OneWay}"/>
                    <!-- Reading mode offers what reading needs: copying and selecting. Undo, cut, paste and delete would change
                         the document (undo did, through the host's history), so they are not there. -->
                    <MenuFlyoutItem x:Name="UndoItem" Visibility="{x:Bind Settings.ReadOnly, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" Text="{u:LocaleString Key=Undo}" KeyboardAcceleratorTextOverride="{x:Bind Settings.ShortcutUndo, Mode=OneWay, Converter={StaticResource ShortcutKeyToStringConverter}}" Icon="Undo" Command="{x:Bind Editor.UndoCommand}" IsEnabled="{x:Bind Editor.History.Undoable, Mode=OneWay}"/>
                    <!-- Undo and redo as a pair (the edit menu has both; this one had only undo - the context menu report's M10). -->
                    <MenuFlyoutItem x:Name="RedoItem" Visibility="{x:Bind Settings.ReadOnly, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" Text="{u:LocaleString Key=Redo}" KeyboardAcceleratorTextOverride="{x:Bind Settings.ShortcutRedo, Mode=OneWay, Converter={StaticResource ShortcutKeyToStringConverter}}" Icon="Redo" Command="{x:Bind Editor.RedoCommand}" IsEnabled="{x:Bind Editor.History.Redoable, Mode=OneWay}"/>
                    <MenuFlyoutSeparator x:Name="UndoSeparator" Visibility="{x:Bind Settings.ReadOnly, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}"/>
                    <MenuFlyoutItem x:Name="CutItem" Visibility="{x:Bind local:EditorContainer.EditVisibility(Settings.ReadOnly, Editor.ContextMenuOnGhost), Mode=OneWay}" Text="{u:LocaleString Key=Cut}" Icon="Cut" Command="{x:Bind Editor.CutCommand}" IsEnabled="{x:Bind Editor.Selected, Mode=OneWay}" CommandParameter="normal" KeyboardAcceleratorTextOverride="{x:Bind Settings.ShortcutCut, Mode=OneWay, Converter={StaticResource ShortcutKeyToStringConverter}}"/>
                    <MenuFlyoutItem x:Name="CopyItem" Text="{u:LocaleString Key=Copy}" Icon="Copy" Command="{x:Bind Editor.CopyCommand}" IsEnabled="{x:Bind Editor.Selected, Mode=OneWay}" CommandParameter="normal" KeyboardAcceleratorTextOverride="{x:Bind Settings.ShortcutCopy, Mode=OneWay, Converter={StaticResource ShortcutKeyToStringConverter}}"/>
                    <!-- Copying, then pasting (the menu report's M06: Copy as plain text at the top level, Markdown and HTML in a
                         submenu with a paste among them). In source mode the text is the Markdown: no Copy As (M02). -->
                    <MenuFlyoutSubItem x:Name="CopyAsSubItem" Text="{u:LocaleString Key=CopyAsMenu}" Visibility="{x:Bind Settings.SourceCode, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}">
                        <MenuFlyoutItem x:Name="CopyAsPlainTextItem" Text="{u:LocaleString Key=PlainTextFormat}" Command="{x:Bind Editor.CopyCommand}" CommandParameter="copyAsPlainText" IsEnabled="{x:Bind Editor.Selected, Mode=OneWay}" KeyboardAcceleratorTextOverride="{x:Bind Settings.ShortcutCopyAsPlainText, Mode=OneWay, Converter={StaticResource ShortcutKeyToStringConverter}}"/>
                        <MenuFlyoutItem x:Name="CopyAsMarkdownItem" Text="Markdown" Command="{x:Bind Editor.CopyCommand}" CommandParameter="copyAsMarkdown" IsEnabled="{x:Bind Editor.Selected, Mode=OneWay}" KeyboardAcceleratorTextOverride="{x:Bind Settings.ShortcutCopyAsMarkdown, Mode=OneWay, Converter={StaticResource ShortcutKeyToStringConverter}}"/>
                        <MenuFlyoutItem x:Name="CopyAsHTMLCodeItem" Text="HTML" Command="{x:Bind Editor.CopyCommand}" CommandParameter="copyAsHtml" IsEnabled="{x:Bind Editor.Selected, Mode=OneWay}" KeyboardAcceleratorTextOverride="{x:Bind Settings.ShortcutCopyAsHTMLCode, Mode=OneWay, Converter={StaticResource ShortcutKeyToStringConverter}}"/>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutItem x:Name="PasteItem" Visibility="{x:Bind local:EditorContainer.EditVisibility(Settings.ReadOnly, Editor.ContextMenuOnGhost), Mode=OneWay}" Text="{u:LocaleString Key=Paste}" Icon="Paste" Command="{x:Bind Editor.PasteCommand}" CommandParameter="normal" KeyboardAcceleratorTextOverride="{x:Bind Settings.ShortcutPaste, Mode=OneWay, Converter={StaticResource ShortcutKeyToStringConverter}}"/>
                    <MenuFlyoutItem x:Name="PasteAsPlainTextItem" Visibility="{x:Bind local:EditorContainer.IsPasteAsVisible(Settings.SourceCode, Settings.ReadOnly, Editor.ContextMenuOnGhost), Mode=OneWay}" Text="{u:LocaleString Key=PasteAsPlainText}" Command="{x:Bind Editor.PasteCommand}" CommandParameter="pasteAsPlainText" KeyboardAcceleratorTextOverride="{x:Bind Settings.ShortcutPasteAsPlainText, Mode=OneWay, Converter={StaticResource ShortcutKeyToStringConverter}}"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Name="DeleteItem" Visibility="{x:Bind local:EditorContainer.EditVisibility(Settings.ReadOnly, Editor.ContextMenuOnGhost), Mode=OneWay}" Icon="Delete" Text="{u:LocaleString Key=Delete}" Command="{x:Bind Editor.DeleteSelectionCommand}" IsEnabled="{x:Bind Editor.Selected, Mode=OneWay}" KeyboardAcceleratorTextOverride="{x:Bind Settings.ShortcutDelete, Mode=OneWay, Converter={StaticResource ShortcutKeyToStringConverter}}"/>
                    <MenuFlyoutSeparator x:Name="DeleteSeparator" Visibility="{x:Bind Settings.ReadOnly, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}"/>
                    <MenuFlyoutItem x:Name="SelectAllItem" Icon="SelectAll" Text="{u:LocaleString Key=SelectAll}" Command="{x:Bind Editor.SelectAllCommand}" KeyboardAcceleratorTextOverride="{x:Bind Settings.ShortcutSelectAll, Mode=OneWay, Converter={StaticResource ShortcutKeyToStringConverter}}"/>
                </MenuFlyout>
            </ContentPresenter.ContextFlyout>
        </ContentPresenter>
        <!-- The home page over the editor of a blank tab; a file or picture dropped on it goes where a drop on the editor goes. -->
        <local:HomePage x:Name="HomeView" AllowDrop="True" DragEnter="OnDragEnter" Drop="OnDrop"/>
        <ScrollViewer x:Name="EditorInitErrorView" x:Load="{x:Bind ViewModel.MarkdownEditor.IsEditorLoadFailed, Mode=OneWay}">
            <StackPanel Margin="24" Spacing="8">
                <TextBlock TextWrapping="Wrap" Text="{u:LocaleString Key=EditorInitErrorMessage}"/>
                <HyperlinkButton Content="Microsoft WebView2 Runtime" NavigateUri="https://developer.microsoft.com/microsoft-edge/webview2/#download" Margin="-12,0,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <ScrollBar 
            x:Name="HorizontalScrollBar" 
            Orientation="Horizontal" 
            VerticalAlignment="Bottom" 
            IndicatorMode="MouseIndicator" 
            Scroll="OnScroll" 
            Visibility="{x:Bind IsScrollBarVisibility(ScrollState.MaximumX), Mode=OneWay}"
            SmallChange="{x:Bind GetSmallChange(Settings.FontSize, Settings.LineHeight), Mode=OneWay}"
            LargeChange="{x:Bind ScrollState.ViewportWidth, Mode=OneWay}"
            Value="{x:Bind ScrollState.ScrollX, Mode=OneWay}"
            ViewportSize="{x:Bind ScrollState.ViewportWidth, Mode=OneWay}"
            Maximum="{x:Bind ScrollState.MaximumX, Mode=OneWay}"/>
        <ScrollBar 
            x:Name="VerticalScrollBar" 
            Orientation="Vertical" 
            HorizontalAlignment="Right" 
            IndicatorMode="MouseIndicator" 
            Scroll="OnScroll" 
            Visibility="{x:Bind IsScrollBarVisibility(ScrollState.MaximumY), Mode=OneWay}"
            SmallChange="{x:Bind GetSmallChange(Settings.FontSize, Settings.LineHeight), Mode=OneWay}"
            LargeChange="{x:Bind ScrollState.ViewportHeight, Mode=OneWay}"
            Value="{x:Bind ScrollState.ScrollY, Mode=OneWay}"
            ViewportSize="{x:Bind ScrollState.ViewportHeight, Mode=OneWay}"
            Maximum="{x:Bind ScrollState.MaximumY, Mode=OneWay}"/>
        <float:FindReplace 
            x:Name="FindReplaceDialog" 
            x:Load="{x:Bind IsFindReplaceLoad, Mode=OneWay}"
            RenderTransform="{StaticResource FindReplaceTransform}"/>
        <!-- An edition's page over all of it (EditionHooks.ShowOverlay): the writing timeline. -->
        <ContentPresenter x:Name="EditionOverlayHost" Visibility="Collapsed"/>
    </Grid>
</UserControl>
