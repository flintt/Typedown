<UserControl
    x:Class="Typedown.Core.Controls.StatusBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Typedown.Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:converters="using:Typedown.Core.Converters"
    xmlns:controls="using:Typedown.Core.Controls"
    xmlns:u="using:Typedown.Core.Utilities"
    Unloaded="OnUnloaded"
    mc:Ignorable="d"
    FontSize="12"
    d:DesignHeight="300"
    d:DesignWidth="400">
    <UserControl.Resources>
        <converters:BoolToObjectConverter x:Key="SidePaneIconConverter" TrueValue="&#xea49;" FalseValue="&#xea5b;"/>
        <!-- The bar's own buttons: no fill until the pointer is over them, as the side pane switch. -->
        <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource SubtleFillColorTransparent}"/>
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SubtleFillColorSecondary}"/>
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SubtleFillColorTertiary}"/>
        <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource TextFillColorSecondary}"/>
        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource TextFillColorPrimary}"/>
        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource TextFillColorSecondary}"/>
        <Style x:Key="StatsLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="RootGrid" BorderThickness="0,1,0,0" Padding="4,2,4,3" BorderBrush="{ThemeResource CardStrokeColorDefault}" SizeChanged="OnBarSizeChanged">
        <!-- Right-click: which items the bar shows. -->
        <Grid.ContextFlyout>
            <MenuFlyout x:Name="ItemsMenu" Opening="OnItemsMenuOpening"/>
        </Grid.ContextFlyout>
        <Grid.Background>
            <SolidColorBrush Color="{ThemeResource SolidBackgroundFillColorBase}" Opacity="0.5"/>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="LeftItems" Orientation="Horizontal" Spacing="4">
            <ToggleButton Padding="6" BorderThickness="0" IsChecked="{x:Bind Settings.SidePaneOpen, Mode=TwoWay}" controls:ToolTip.TextResource="SidePane">
                <ToggleButton.Resources>
                    <ResourceDictionary>
                        <SolidColorBrush x:Key="ToggleButtonBackground" Color="{ThemeResource SubtleFillColorTransparent}" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource SubtleFillColorTransparent}" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{ThemeResource SubtleFillColorSecondary}" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="{ThemeResource SubtleFillColorTertiary}" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource SubtleFillColorSecondary}" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource SubtleFillColorTertiary}" />
                        <SolidColorBrush x:Key="ToggleButtonForeground" Color="{ThemeResource TextFillColorSecondary}" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource TextFillColorSecondary}" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="{ThemeResource TextFillColorSecondary}" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource TextFillColorSecondary}" />
                    </ResourceDictionary>
                </ToggleButton.Resources>
                <FontIcon Glyph="{x:Bind Settings.SidePaneOpen, Converter={StaticResource SidePaneIconConverter}, Mode=OneWay}" FontSize="14"/>
            </ToggleButton>
            <!-- The mode the document is in (visual, source, reading) as its icon; a click lists the modes to switch. -->
            <Button
                x:Name="ModeButton"
                Padding="6"
                BorderThickness="0"
                VerticalAlignment="Stretch"
                AutomationProperties.AutomationId="StatusBarModes"
                AutomationProperties.Name="{u:LocaleString Key=View}"
                controls:ToolTip.TextResource="View">
                <FontIcon Glyph="{x:Bind ModeGlyph(Settings.ReadOnly, Settings.SourceCode), Mode=OneWay}" FontSize="14"/>
                <Button.Flyout>
                    <MenuFlyout Placement="TopEdgeAlignedLeft" Opening="OnModeMenuOpening">
                        <ToggleMenuFlyoutItem x:Name="StatusSourceCodeItem" Text="{u:LocaleString Key=SourceCodeMode}" IsChecked="{x:Bind Settings.SourceCode, Mode=TwoWay}"/>
                        <ToggleMenuFlyoutItem x:Name="StatusReadOnlyItem" Text="{u:LocaleString Key=ReadOnlyMode}" IsChecked="{x:Bind Settings.ReadOnly, Mode=TwoWay}"/>
                        <MenuFlyoutSeparator/>
                        <ToggleMenuFlyoutItem x:Name="StatusFocusItem" Text="{u:LocaleString Key=FocusMode}" IsChecked="{x:Bind Settings.FocusMode, Mode=TwoWay}" IsEnabled="{x:Bind CaretModes(Settings.ReadOnly, Settings.SourceCode), Mode=OneWay}"/>
                        <ToggleMenuFlyoutItem x:Name="StatusTypewriterItem" Text="{u:LocaleString Key=TypewriterMode}" IsChecked="{x:Bind Settings.Typewriter, Mode=TwoWay}" IsEnabled="{x:Bind CaretModes(Settings.ReadOnly, Settings.SourceCode), Mode=OneWay}"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <!-- One click into reading mode; the badge below takes its place there and is the way back. -->
            <Button
                x:Name="ReadingButton"
                Padding="6"
                BorderThickness="0"
                VerticalAlignment="Stretch"
                Click="OnEnterReadOnlyClick"
                AutomationProperties.AutomationId="StatusBarReading"
                AutomationProperties.Name="{u:LocaleString Key=ReadOnlyMode}">
                <FontIcon Glyph="&#xE890;" FontSize="14"/>
            </Button>
            <!-- Reading mode ignores every keystroke; say so where it can be seen, and let the label switch it off. -->
            <Button
                x:Name="ReadOnlyBadge"
                x:Load="{x:Bind Settings.ReadOnly, Mode=OneWay}"
                Padding="8,2,8,2"
                BorderThickness="0"
                VerticalAlignment="Stretch"
                Click="OnLeaveReadOnlyClick"
                AutomationProperties.AutomationId="StatusBarReadOnlyBadge"
                controls:ToolTip.TextResource="ReadOnlyMode">
                <Button.Resources>
                    <ResourceDictionary>
                        <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource SubtleFillColorSecondary}"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SubtleFillColorTertiary}"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SubtleFillColorSecondary}"/>
                        <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource TextFillColorSecondary}"/>
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource TextFillColorPrimary}"/>
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource TextFillColorSecondary}"/>
                    </ResourceDictionary>
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE890;" FontSize="12"/>
                    <TextBlock FontSize="12" Text="{u:LocaleString Key=ReadOnlyMode}"/>
                </StackPanel>
            </Button>
            <!-- The heading the caret is under; a click opens the outline. -->
            <Button
                x:Name="HeadingButton"
                Padding="8,2,8,2"
                BorderThickness="0"
                VerticalAlignment="Stretch"
                Visibility="Collapsed"
                Click="OnHeadingClick"
                AutomationProperties.AutomationId="StatusBarHeading"
                controls:ToolTip.TextResource="Outline">
                <TextBlock x:Name="HeadingText" FontSize="12" MaxWidth="240" TextTrimming="CharacterEllipsis"/>
            </Button>
        </StackPanel>
        <StackPanel x:Name="RightItems" Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <!-- What a narrow window has no room for, in a menu. -->
            <Button
                x:Name="OverflowButton"
                Padding="8,2,8,2"
                BorderThickness="0"
                VerticalAlignment="Stretch"
                Visibility="Collapsed"
                AutomationProperties.AutomationId="StatusBarOverflow"
                controls:ToolTip.TextResource="MoreOptions">
                <FontIcon Glyph="&#xE712;" FontSize="12"/>
                <Button.Flyout>
                    <MenuFlyout x:Name="OverflowMenu" Placement="TopEdgeAlignedRight" Opening="OnOverflowMenuOpening"/>
                </Button.Flyout>
            </Button>
            <!-- How the file is written (encoding, line ending); a click changes the line ending, converts the file to
                 UTF-8, or reads it again in another encoding. -->
            <Button
                x:Name="FileFormatButton"
                Padding="8,2,8,2"
                BorderThickness="0"
                VerticalAlignment="Stretch"
                FontSize="12"
                AutomationProperties.AutomationId="StatusBarFileFormat"
                controls:ToolTip.TextResource="Encoding.Tip">
                <TextBlock Text="{x:Bind FormatText(ViewModel.FileViewModel.FileFormat), Mode=OneWay}"/>
                <Button.Flyout>
                    <MenuFlyout x:Name="FileFormatMenu" Placement="TopEdgeAlignedRight" Opening="OnFileFormatMenuOpening"/>
                </Button.Flyout>
            </Button>
            <!-- Whether the document is on disk, and when auto-save held it back, why (in the tip); a click saves it. -->
            <Button
                x:Name="SaveStateButton"
                Padding="8,2,8,2"
                BorderThickness="0"
                VerticalAlignment="Stretch"
                Click="OnSaveStateClick"
                AutomationProperties.AutomationId="StatusBarSaveState"
                AutomationProperties.HelpText="{x:Bind SaveStateTip(Editor.Saved, Editor.AutoSaveHeldBack), Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind SaveStateTip(Editor.Saved, Editor.AutoSaveHeldBack), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="{x:Bind SaveStateGlyph(Editor.Saved, Editor.AutoSaveHeldBack), Mode=OneWay}" FontSize="12"/>
                    <TextBlock FontSize="12" Text="{x:Bind SaveStateText(Editor.Saved, Editor.AutoSaveHeldBack), Mode=OneWay}"/>
                </StackPanel>
            </Button>
            <!-- The count the reader chose (characters or words); a click shows all the document's numbers. -->
            <Button
                x:Name="WordCountButton"
                Padding="8,2,8,2"
                BorderThickness="0"
                VerticalAlignment="Stretch"
                FontSize="12"
                IsEnabled="{x:Bind ViewModel.MarkdownEditor.IsEditorLoaded, Mode=OneWay}"
                AutomationProperties.AutomationId="StatusBarWordCount"
                controls:ToolTip.TextResource="WordCount">
                <TextBlock Text="{x:Bind CountText(Editor.ContentState, Settings.WordCountMethod, Editor.SelectionText), Mode=OneWay}"/>
                <Button.Flyout>
                    <Flyout Placement="TopEdgeAlignedRight" Opening="OnStatsOpening">
                        <StackPanel MinWidth="240" Spacing="10">
                            <Grid x:Name="StatsGrid" ColumnSpacing="24" RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                            <TextBlock Text="{u:LocaleString Key=Stats.Note}" TextWrapping="Wrap" MaxWidth="260" HorizontalAlignment="Left" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{u:LocaleString Key=Stats.ShownInStatusBar}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <RadioButton x:Name="ShowCharacters" GroupName="StatusCount" MinWidth="0" Content="{u:LocaleString Key=Characters}" Checked="OnCountMethodChecked"/>
                                    <RadioButton x:Name="ShowWords" GroupName="StatusCount" MinWidth="0" Content="{u:LocaleString Key=Words}" Checked="OnCountMethodChecked"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
