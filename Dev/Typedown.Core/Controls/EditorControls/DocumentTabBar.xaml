<UserControl
    x:Class="Typedown.Core.Controls.DocumentTabBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Typedown.Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:Typedown.Core.Models"
    xmlns:u="using:Typedown.Core.Utilities"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!-- A tab's right-click menu: closing it or others, its file (none for an untitled document) and the favourites. The
             entries are told apart by Tag as it opens (OnTabContextFlyoutOpening). -->
        <MenuFlyout x:Key="TabContextFlyout" Opening="OnTabContextFlyoutOpening">
            <MenuFlyoutItem Tag="Close" AutomationProperties.AutomationId="TabCloseItem" Text="{u:LocaleString Key=Close}" Click="OnTabCloseClick"/>
            <MenuFlyoutItem Tag="CloseOthers" AutomationProperties.AutomationId="TabCloseOthersItem" Text="{u:LocaleString Key=Tab.CloseOthers}" Click="OnTabCloseOthersClick"/>
            <MenuFlyoutItem Tag="CloseToTheRight" AutomationProperties.AutomationId="TabCloseToTheRightItem" Text="{u:LocaleString Key=Tab.CloseToTheRight}" Click="OnTabCloseToTheRightClick"/>
            <MenuFlyoutSeparator/>
            <!-- Every file menu's core, in its order (Services.FileEntryActions), then the tab's own. -->
            <MenuFlyoutItem Tag="Favorite" AutomationProperties.AutomationId="TabFavoriteItem" Text="Favorite" Click="OnTabFavoriteClick"/>
            <MenuFlyoutItem Tag="File" AutomationProperties.AutomationId="TabOpenLocationItem" Text="{u:LocaleString Key=OpenFileLocation}" Click="OnTabOpenLocationClick"/>
            <MenuFlyoutItem Tag="File" AutomationProperties.AutomationId="TabCopyPathItem" Text="{u:LocaleString Key=CopyAsPath}" Click="OnTabCopyPathClick"/>
            <MenuFlyoutItem Tag="File" AutomationProperties.AutomationId="TabShowInSideBarItem" Text="{u:LocaleString Key=Tab.ShowInSideBar}" Click="OnTabShowInSideBarClick"/>
        </MenuFlyout>
    </UserControl.Resources>
    <muxc:TabView
        x:Name="TabView"
        TabItemsSource="{x:Bind Tabs.Tabs, Mode=OneWay}"
        SelectedItem="{x:Bind Tabs.ActiveTab, Mode=OneWay}"
        SelectionChanged="OnSelectionChanged"
        AddTabButtonClick="OnAddTabButtonClick"
        TabCloseRequested="OnTabCloseRequested"
        TabItemsChanged="OnTabItemsChanged"
        TabDragStarting="OnTabDragStarting"
        TabDragCompleted="OnTabDragCompleted"
        TabWidthMode="SizeToContent"
        CanReorderTabs="True"
        CanDragTabs="False"
        IsAddTabButtonVisible="True"
        Background="Transparent">
        <!-- The home page (File > Home), at the strip's left: the open documents stay as they are. -->
        <muxc:TabView.TabStripHeader>
            <Button x:Name="HomeButton" AutomationProperties.AutomationId="HomeButton" Width="32" Height="28" Margin="4,0,0,0" Padding="0"
                    Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                    ToolTipService.ToolTip="{x:Bind HomeToolTip, Mode=OneWay}" AutomationProperties.Name="{x:Bind HomeToolTip, Mode=OneWay}"
                    Click="OnHomeButtonClick">
                <FontIcon FontSize="14" Glyph="&#xe80f;"/>
            </Button>
        </muxc:TabView.TabStripHeader>
        <muxc:TabView.TabItemTemplate>
            <DataTemplate x:DataType="models:DocumentTab">
                <!-- A tab clicked leaves the keyboard in the document (AllowFocusOnInteraction): taken by the tab, it came back
                     only once the window's thread was free, and with a long document coming in the keys typed meanwhile were
                     lost (E2E TL01). The keyboard still reaches the tabs with Tab. -->
                <!-- Square at the bottom: a tab being dragged is drawn with the tab's corner radius (its drag look,
                     TabDragVisualContainer), and its bottom came out rounded, unlike a tab in the strip (the user, 2026-11-11).
                     The shown tab's card has a shape of its own. -->
                <!-- Each tab as wide as its title at its widest - bold, as the tab shown is drawn, and with the unsaved mark: a
                     tab sized to its title changed width as it became the one shown, or unsaved, and the + after the tabs
                     moved with it (the user, 2026-11-11). An unseen copy at that width holds the place. -->
                <muxc:TabViewItem CornerRadius="8,8,0,0" AutomationProperties.Name="{x:Bind DisplayTitle, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneWay}" IsClosable="True" ContextFlyout="{StaticResource TabContextFlyout}" AllowFocusOnInteraction="False">
                    <muxc:TabViewItem.Header>
                        <Grid>
                            <TextBlock Text="{x:Bind WidestTitle, Mode=OneWay}" FontWeight="SemiBold" Opacity="0" AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock Text="{x:Bind DisplayTitle, Mode=OneWay}"/>
                        </Grid>
                    </muxc:TabViewItem.Header>
                </muxc:TabViewItem>
            </DataTemplate>
        </muxc:TabView.TabItemTemplate>
    </muxc:TabView>
</UserControl>
