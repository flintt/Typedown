<controls:MenuItemCollection
    xmlns:controls="using:Typedown.Core.Controls"
    x:Class="Typedown.Core.Controls.EditorControls.ContextMenuItems.ImageItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Typedown.Core.Controls.EditorControls.ContextMenuItems"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:u="using:Typedown.Core.Utilities"
    xmlns:viewmodels="using:Typedown.Core.ViewModels" 
    mc:Ignorable="d">
    <!-- A copy kept elsewhere (the document unchanged) first; then what changes the document's reference (copy or move
         and point the picture there, upload); where it is; deleting the file on disk last, apart (the context menu
         report's M03, M07). -->
    <MenuFlyoutItem x:Name="SaveImageItem" Text="{u:LocaleString Key=SaveImageAs}" Click="OnSaveImageClick" Loaded="OnImageMenuLoaded"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem x:Name="CopyImageItem" Text="{u:LocaleString Key=CopyImageTo}" Click="OnCopyImageToClick"/>
    <MenuFlyoutItem x:Name="MoveImageItem" Text="{u:LocaleString Key=MoveImageTo}" Click="OnMoveImageToClick"/>
    <!-- A picture kept in the document (a data: address, #52) put in a file in the image folder, and the other way. -->
    <MenuFlyoutItem x:Name="ExtractImageItem" AutomationProperties.AutomationId="ExtractImageItem" Text="{u:LocaleString Key=ImageMenu.ExtractToFolder}" Click="OnExtractImageClick"/>
    <MenuFlyoutItem x:Name="EmbedImageItem" AutomationProperties.AutomationId="EmbedImageItem" Text="{u:LocaleString Key=ImageMenu.EmbedAsBase64}" Click="OnEmbedImageClick"/>
    <MenuFlyoutItem x:Name="ReplaceImageItem" AutomationProperties.AutomationId="ReplaceImageItem" Text="{u:LocaleString Key=ImageMenu.Replace}" Click="OnReplaceImageClick"/>
    <MenuFlyoutSubItem x:Name="UploadSubMenu" Text="{u:LocaleString Key=UploadImage}">
        <!-- A picture from the web, or not a file: nothing to upload, and the menu says so (the report's M04: the entries
             were there and did nothing). -->
        <MenuFlyoutItem x:Name="UploadLocalOnlyItem" AutomationProperties.AutomationId="UploadLocalOnlyItem" Text="{u:LocaleString Key=UploadImageLocalOnly}" IsEnabled="False"/>
        <MenuFlyoutItem x:Name="NoUploadConfigItem" Text="{u:LocaleString Key=NoImageUploadConfiguration}" IsEnabled="False"/>
        <MenuFlyoutSeparator/>
        <MenuFlyoutItem Text="{u:LocaleString Key=ImageUploadSettings}" Click="OnImageUploadSettingsClick"/>
    </MenuFlyoutSubItem>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem x:Name="OpenImageLocationItem" Text="{u:LocaleString Key=OpenImageLocation}" Click="OnOpenImageLocationClick"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem x:Name="DeleteImageItem" Text="{u:LocaleString Key=DeleteImageFile}" Click="OnDeleteImageFileClick"/>
</controls:MenuItemCollection>
