<MenuFlyoutItem
    x:Class="Typedown.Core.Controls.EditorControls.ContextMenuItems.FormatItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Typedown.Core.Controls.EditorControls.ContextMenuItems"
    xmlns:controls="using:Typedown.Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Typedown.Core.ViewModels" 
    mc:Ignorable="d">
    <MenuFlyoutItem.Template>
        <ControlTemplate TargetType="MenuFlyoutItem">
            <StackPanel Orientation="Horizontal" Spacing="4" Padding="4,2,4,2" d:DataContext="{d:DesignInstance Type=viewmodels:AppViewModel}">
                <!-- Checked where the selection already has the format (FormatState, as View > Format ticks it): the user,
                     2026-11-13 - the buttons said nothing of it. -->
                <controls:StateToggleButton Style="{StaticResource EllipsisIconToggleButtonStyle}" Command="{Binding FormatViewModel.SetFormatCommand}" CommandParameter="strong" IsChecked="{Binding FormatViewModel.FormatState.Bold, Mode=OneWay}" AutomationProperties.AutomationId="ContextFormatStrong" controls:ToolTip.TextResource="Strong">
                    <FontIcon FontSize="16" Glyph="&#xE8DD;"/>
                </controls:StateToggleButton>
                <controls:StateToggleButton Style="{StaticResource EllipsisIconToggleButtonStyle}" Command="{Binding FormatViewModel.SetFormatCommand}" CommandParameter="em" IsChecked="{Binding FormatViewModel.FormatState.Italic, Mode=OneWay}" AutomationProperties.AutomationId="ContextFormatEmphasis" controls:ToolTip.TextResource="Emphasis">
                    <FontIcon FontSize="16" Glyph="&#xE8DB;"/>
                </controls:StateToggleButton>
                <controls:StateToggleButton Style="{StaticResource EllipsisIconToggleButtonStyle}" Command="{Binding FormatViewModel.SetFormatCommand}" CommandParameter="u" IsChecked="{Binding FormatViewModel.FormatState.Underline, Mode=OneWay}" AutomationProperties.AutomationId="ContextFormatUnderline" controls:ToolTip.TextResource="Underline">
                    <FontIcon FontSize="16" Glyph="&#xE8DC;"/>
                </controls:StateToggleButton>
                <controls:StateToggleButton Style="{StaticResource EllipsisIconToggleButtonStyle}" Command="{Binding FormatViewModel.SetFormatCommand}" CommandParameter="del" IsChecked="{Binding FormatViewModel.FormatState.Strikethrough, Mode=OneWay}" AutomationProperties.AutomationId="ContextFormatStrikethrough" controls:ToolTip.TextResource="Strikethrough">
                    <FontIcon FontSize="16" Glyph="&#xEDE0;"/>
                </controls:StateToggleButton>
                <Button Style="{StaticResource EllipsisIconButtonStyle}" Command="{Binding FormatViewModel.SetFormatCommand}" CommandParameter="clear" AutomationProperties.AutomationId="ContextFormatClear" controls:ToolTip.TextResource="ClearFormat">
                    <FontIcon FontSize="16" Glyph="&#xe75c;"/>
                </Button>
            </StackPanel>
        </ControlTemplate>
    </MenuFlyoutItem.Template>
</MenuFlyoutItem>
