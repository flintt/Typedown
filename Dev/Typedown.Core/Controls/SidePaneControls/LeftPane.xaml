<UserControl
    x:Class="Typedown.Core.Controls.LeftPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Typedown.Core.Controls"
    xmlns:pages="using:Typedown.Core.Controls.SidePanelControls.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Typedown.Core.Converters"
    xmlns:u="using:Typedown.Core.Utilities"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityReverseConverter" IsReverse="True"/>
        <!-- A block's title row: the whole row is the button that folds the block away and opens it out again. -->
        <Style x:Key="BlockHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,0,8,0"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="Root">
        <!-- Files above, the outline below, a bar between them to drag; each folds to its title row. The id is the one the
             tests measure the pane by (it was the Files/Outline tabs' NavigationView). -->
        <local:AutomationGrid
            x:Name="Blocks"
            AutomationProperties.AutomationId="NavigationView"
            Visibility="{x:Bind local:LeftPane.PageVisibility(IsSearchPaneOpen, IsFindResultsOpen), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="FilesRow" Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="OutlineRow" Height="*"/>
            </Grid.RowDefinitions>
            <Grid Height="32" Margin="4,4,4,0">
                <Button x:Name="Folder" AutomationProperties.AutomationId="Folder" Style="{StaticResource BlockHeaderButtonStyle}" Click="OnFilesHeaderClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="FilesChevron" FontSize="10" Glyph="&#xe70d;"/>
                        <TextBlock x:Name="FilesTitle" Text="{u:LocaleString Key=Files}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Width="32" Height="32" x:Name="SearchButton" HorizontalAlignment="Right" Click="OnSearchButtonClick" Style="{ThemeResource EllipsisIconButtonStyle}" local:ToolTip.TextResource="SearchInFolder">
                    <FontIcon FontSize="14" Glyph="&#xe721;"/>
                </Button>
            </Grid>
            <pages:FolderPage x:Name="FilesPage" Grid.Row="1"/>
            <local:RowSplitter x:Name="BlockSplitter" Grid.Row="2" Canvas.ZIndex="1"/>
            <Border Grid.Row="3" Height="37" Padding="4,4,4,0" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Button x:Name="Toc" AutomationProperties.AutomationId="Toc" Style="{StaticResource BlockHeaderButtonStyle}" Click="OnOutlineHeaderClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="OutlineChevron" FontSize="10" Glyph="&#xe70d;"/>
                        <TextBlock x:Name="OutlineTitle" Text="{u:LocaleString Key=Outline}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Border>
            <!-- Made only while open: a folded outline is not rebuilt with every edit of a long document. -->
            <pages:TocPage x:Name="OutlinePage" Grid.Row="4" x:Load="{x:Bind OutlineOpen, Mode=OneWay}"/>
        </local:AutomationGrid>
        <local:SearchPane x:Name="SearchPane" x:Load="{x:Bind IsSearchPaneOpen, Mode=OneWay}" Close="OnSearchPaneClose"
                          Visibility="{x:Bind IsFindResultsOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}"/>
        <!-- The find bar's results list, over the pane's blocks (they come back when it closes). -->
        <local:FindResultsPane x:Name="FindResultsPane" AutomationProperties.AutomationId="FindResultsPane"
                               x:Load="{x:Bind IsFindResultsOpen, Mode=OneWay}" Close="OnFindResultsPaneClose"/>
    </Grid>
</UserControl>
