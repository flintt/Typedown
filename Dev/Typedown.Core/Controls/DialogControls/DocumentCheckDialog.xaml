<UserControl
    x:Class="Typedown.Core.Controls.DocumentCheckDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Typedown.Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Width="520" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="Summary" AutomationProperties.AutomationId="DocumentCheckSummary" TextWrapping="Wrap"/>
        <ListView x:Name="Problems" Grid.Row="1" AutomationProperties.AutomationId="DocumentCheckList" MaxHeight="360"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:DocumentProblemRow">
                    <StackPanel Padding="0,4">
                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind Detail}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
