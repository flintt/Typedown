<UserControl
    x:Class="Typedown.Core.Controls.WebView2InstallControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Typedown.Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:chrome="using:Typedown.Core.Utilities"
    xmlns:u="using:Typedown.Core.Utilities"
    mc:Ignorable="d"
    Unloaded="OnUnloaded"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.RowSpan="3" VerticalAlignment="Top" Orientation="Horizontal" Height="32" Padding="8,0" Spacing="8">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="chrome:WindowChrome.Drag" Value="True"/>
                </Style>
            </StackPanel.Style>
        </StackPanel>
        <TextBlock 
            Text="{u:LocaleString Key=WebView2RuntimeNotInstalledTitle}" 
            FontSize="20"
            Margin="24,24,0,8"
            VerticalAlignment="Center" 
            FontFamily="{StaticResource ContentControlThemeFontFamily}"/>
        <ScrollViewer Grid.Row="1" Padding="24,0">
            <StackPanel Spacing="8">
                <TextBlock TextWrapping="Wrap" Text="{u:LocaleString Key=WebView2RuntimeNotInstalledContent}"/>
                <!-- Said after the bundled setup ran and the runtime is still not there (offline, elevation refused):
                     the window comes back with this instead of the app ending without a word. -->
                <TextBlock
                    x:Name="InstallFailedText"
                    AutomationProperties.AutomationId="WebView2InstallFailedText"
                    Visibility="Collapsed"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{u:LocaleString Key=WebView2InstallFailed}"/>
                <HyperlinkButton
                    x:Name="DownloadLink"
                    AutomationProperties.AutomationId="WebView2DownloadLink"
                    Content="{u:LocaleString Key=WebView2DownloadLink}"
                    NavigateUri="https://developer.microsoft.com/microsoft-edge/webview2/#download"
                    Margin="-12,0"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,0,16,16" Spacing="8" HorizontalAlignment="Right">
            <Button MinWidth="80" AutomationProperties.AutomationId="WebView2InstallButton" Style="{ThemeResource AccentButtonStyle}" Click="OnInstallButtonClick" Content="{u:LocaleString Key=InstallNow}"/>
            <Button MinWidth="80" AutomationProperties.AutomationId="WebView2CancelButton" Click="OnCloseButtonClick" Content="{u:LocaleString Key=Cancel}"/>
        </StackPanel>
    </Grid>
</UserControl>
