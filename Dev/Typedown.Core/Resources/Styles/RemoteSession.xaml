<ResourceDictionary 
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Loaded only in a Remote Desktop session (Resources.cs). There the acrylic of menus, drop-downs and tooltips was
         drawn as a see-through dark grey, with black text on it under a light theme. They get the colours acrylic itself
         falls back to - opaque - by the brushes' own names and by the names the controls look them up by (an alias in
         XamlControlsResources was resolved when that dictionary was loaded and never sees an override). -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="#2C2C2C"/>
            <SolidColorBrush x:Key="AcrylicBackgroundFillColorBaseBrush" Color="#202020"/>
            <SolidColorBrush x:Key="AcrylicInAppFillColorDefaultBrush" Color="#2C2C2C"/>
            <SolidColorBrush x:Key="AcrylicInAppFillColorBaseBrush" Color="#202020"/>
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#2C2C2C"/>
            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#2C2C2C"/>
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#2C2C2C"/>
            <SolidColorBrush x:Key="ToolTipBackground" Color="#2C2C2C"/>
            <SolidColorBrush x:Key="AutoSuggestBoxSuggestionsListBackground" Color="#2C2C2C"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="#F9F9F9"/>
            <SolidColorBrush x:Key="AcrylicBackgroundFillColorBaseBrush" Color="#EEEEEE"/>
            <SolidColorBrush x:Key="AcrylicInAppFillColorDefaultBrush" Color="#F9F9F9"/>
            <SolidColorBrush x:Key="AcrylicInAppFillColorBaseBrush" Color="#EEEEEE"/>
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#F9F9F9"/>
            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#F9F9F9"/>
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#F9F9F9"/>
            <SolidColorBrush x:Key="ToolTipBackground" Color="#F9F9F9"/>
            <SolidColorBrush x:Key="AutoSuggestBoxSuggestionsListBackground" Color="#F9F9F9"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
