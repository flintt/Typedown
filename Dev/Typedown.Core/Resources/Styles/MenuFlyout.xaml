<ResourceDictionary 
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:utils="using:Typedown.Core.Utilities">
    <!-- Every menu (the menu bar's, their submenus, the context menus) gives the keyboard back to the editor when it
         closes and nothing else took it (Utilities/MenuFocus.cs). Based on WinUI's own style, so menus look as before. -->
    <Style TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
        <Setter Property="utils:MenuFocus.ReturnToEditor" Value="True"/>
    </Style>
</ResourceDictionary>
