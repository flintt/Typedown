<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!-- The shared view models, controls, pages and services, ported from the UWP class library to WinUI 3 on .NET 10
       (docs/winui3-dotnet10-migration.md). Sources are picked up by the SDK's globbing; the strings stay .resw files. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.18362.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <!-- System.Reactive asks for the whole Windows desktop framework (WPF and Windows Forms, about 50 MB) on a
         Windows target; nothing here uses its WPF or Windows Forms schedulers. -->
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
    <RootNamespace>Typedown.Core</RootNamespace>
    <AssemblyName>Typedown.Core</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseRidGraph>true</UseRidGraph>
    <Configurations>Debug;Release;Debug_Local</Configurations>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableMsixTooling>true</EnableMsixTooling>
    <NoWarn>$(NoWarn);CA1416;CS8632</NoWarn>
    <!-- Properties\AssemblyInfo.cs carries the version (one of the files a release bumps). -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Typedown.Automation\Typedown.Automation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <!-- Parts of the SDK the app does not use, left out of the build and every install: the AI and ML runtimes
         (onnxruntime and DirectML alone are 38 MB), Widgets and Search. The versions are the ones 2.5.1 asks for. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.5.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.1.94" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.1.74" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="2.0.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Search" Version="2.5.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="PropertyChanged.Fody" Version="4.1.0" PrivateAssets="all" />
    <PackageReference Include="System.Reactive" Version="6.0.1" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Images\logo.ico" />
    <None Remove="Properties\Typedown.Core.rd.xml" />
  </ItemGroup>
</Project>
