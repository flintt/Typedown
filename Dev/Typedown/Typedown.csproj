<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\..\Branding.props" />

	<!-- The application: WinUI 3 (Windows App SDK) on .NET 10, ported from the XAML Islands host on .NET Core 3.1
	     (docs/winui3-dotnet10-migration.md). Built unpackaged for the installer and the portable zip, and as a
	     single-project MSIX with /p:WindowsPackageType=MSIX. -->
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<!-- $(BrandExeName).exe; the projects and namespaces keep their names in every edition. -->
		<AssemblyName>$(BrandExeName)</AssemblyName>
		<RootNamespace>Typedown</RootNamespace>
		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
		<TargetPlatformMinVersion>10.0.18362.0</TargetPlatformMinVersion>
		<UseWinUI>true</UseWinUI>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<Platforms>x64;ARM64</Platforms>
		<RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
		<UseRidGraph>true</UseRidGraph>
		<SelfContained>true</SelfContained>
		<!-- The Windows App SDK runtime travels with the app: the installer and portable builds have no package to
		     depend on, and the MSIX then needs no framework package installed beside it. -->
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
		<EnableMsixTooling>true</EnableMsixTooling>
		<AppxPackageSigningEnabled Condition="'$(AppxPackageSigningEnabled)' == ''">false</AppxPackageSigningEnabled>
		<GenerateAppInstallerFile>false</GenerateAppInstallerFile>
		<GenerateTemporaryStoreCertificate>false</GenerateTemporaryStoreCertificate>
		<StartupObject>Typedown.Program</StartupObject>
		<DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
		<ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
		<ApplicationIcon>Assets\logo.ico</ApplicationIcon>
		<!-- Trimming strips reflection-used code (x:Bind, Fody, EF Core, WinRT projections): off until it is tested on its own. -->
		<PublishTrimmed>false</PublishTrimmed>
		<PublishAot>false</PublishAot>
		<Version>1.3.7</Version>
		<!-- Shown as "File description" in Explorer and "Open with", and indexed by Start menu search (upstream #28): a search
		     for "markdown" finds the installed app. An MSIX shows its manifest's DisplayName there instead, the Start menu's
		     name, which stays the product's alone. -->
		<AssemblyTitle>$(BrandName) - Markdown Editor</AssemblyTitle>
		<Product>$(BrandName) Markdown Editor</Product>
		<Description>$(BrandName) - Markdown Editor</Description>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Configurations>Debug;Release;Debug_Local</Configurations>
		<NoWarn>$(NoWarn);CA1416;CS8632</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Platform)' == 'x64'">
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<AppxBundlePlatforms>x64</AppxBundlePlatforms>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Platform)' == 'ARM64'">
		<RuntimeIdentifier>win-arm64</RuntimeIdentifier>
		<AppxBundlePlatforms>arm64</AppxBundlePlatforms>
	</PropertyGroup>

	<!-- A release is published precompiled (ReadyToRun): the app's own assemblies need no JIT at start. Measured on
	     hp (x64, 2026-10-04, the XAML Islands host): process start to the document shown 2.89-3.00 s -> 2.40-2.49 s. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' != ''">
		<PublishReadyToRun>true</PublishReadyToRun>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="PropertyChanged.Fody" Version="4.1.0" PrivateAssets="all" />
		<PackageReference Include="System.Drawing.Common" Version="10.0.0" />
		<PackageReference Include="System.Reactive" Version="6.0.1" />
	</ItemGroup>

	<ItemGroup>
		<!-- The library is not a package: an MSIX build's packaging properties (given on the command line, so global) are
		     not passed on to it, or it is packaged too and MakeAppx fails for its missing manifest. -->
		<ProjectReference Include="..\Typedown.Core\Typedown.Core.csproj"
		                  GlobalPropertiesToRemove="WindowsPackageType;GenerateAppxPackageOnBuild;AppxBundle;UapAppxPackageBuildMode;AppxPackageSigningEnabled;AppxPackageDir;PackageCertificateKeyFile;PackageCertificatePassword" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Assets\*.png" />
		<Content Include="Assets\logo.ico" CopyToOutputDirectory="PreserveNewest" />
		<None Update="MicrosoftEdgeWebview2Setup.exe" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- An edition's own code and files, in Dev/Edition of the edition's repository (with Edition.<name>.cs here, they
	     are what the edition adds through Edition.cs). Typedown has no such folder: these take nothing. -->
	<ItemGroup Condition="Exists('..\Edition')">
		<Compile Include="..\Edition\**\*.cs" Exclude="..\Edition\**\obj\**;..\Edition\**\bin\**" />
		<Content Include="..\Edition\Resources\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="Resources\Edition\%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Resources\Statics\**" CopyToOutputDirectory="Always" CopyToPublishDirectory="PreserveNewest" Link="Resources\Statics\%(RecursiveDir)%(Filename)%(Extension)" />
		<!-- The themes that ship with the app; the themes folder in %LOCALAPPDATA% is added to these at runtime. -->
		<Content Include="Resources\Themes\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="Resources\Themes\%(RecursiveDir)%(Filename)%(Extension)" />
		<!-- The MIT notice travels with the program (installer, portable zip and MSIX alike). -->
		<Content Include="..\..\LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="LICENSE.txt" />
		<!-- The theme document ships next to the themes, and a copy lands in the user's themes folder. -->
		<Content Include="..\..\docs\custom-theme.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="Resources\Themes\custom-theme.md" />
		<!-- Standalone theme designer. Typedown embeds a snapshot of the installed themes when opening it. -->
		<Content Include="..\..\Tools\Themes\theme-designer.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="Resources\Themes\theme-designer.html" />
	</ItemGroup>

	<!-- The automation test host (docs/automation-api-analysis-plan.md, 10.7): the same application built with
	     /p:AutomationTestHost=true into its own folder, with the edit barriers and test.* methods, its own data root and
	     single-instance names, and a marker file. Never packaged: build-local.ps1 and CI refuse it. -->
	<PropertyGroup Condition="'$(AutomationTestHost)' == 'true'">
		<DefineConstants>$(DefineConstants);AUTOMATION_TEST_HOST</DefineConstants>
		<OutputPath>bin\AutomationTestHost\$(Platform)\$(Configuration)\</OutputPath>
	</PropertyGroup>
	<ItemGroup Condition="'$(AutomationTestHost)' == 'true'">
		<ProjectReference Include="..\Typedown.Automation.TestHost\Typedown.Automation.TestHost.csproj" />
		<Content Include="automation-test-host.marker" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup Condition="'$(AutomationTestHost)' != 'true'">
		<None Remove="automation-test-host.marker" />
	</ItemGroup>

	<!-- The automation command line ($(BrandCliName), and "$(BrandCliName) mcp", the MCP server) with the app, in the same
	     folder, on the app's runtime: published self-contained for the app's runtime identifier, and only the files the
	     app does not have already are added (the runtime and the shared libraries are the app's). Published with the app
	     (the installer and the portable zip) and put in the MSIX at the package root (Package.appxmanifest's Cli entry and
	     execution alias). Not for the automation test host, nor with /p:IncludeCli=false. -->
	<PropertyGroup>
		<_CliProject>$(MSBuildThisFileDirectory)..\..\Tools\Typedown.Cli\Typedown.Cli.csproj</_CliProject>
		<_CliPublishDir>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)cli-publish\$(Configuration)\$(RuntimeIdentifier)</_CliPublishDir>
	</PropertyGroup>
	<Target Name="PublishCli" Condition="'$(RuntimeIdentifier)' != '' and '$(AutomationTestHost)' != 'true' and '$(IncludeCli)' != 'false'">
		<RemoveDir Directories="$(_CliPublishDir)" />
		<!-- The dotnet running this build (DOTNET_HOST_PATH), not the first on PATH: another SDK's dotnet would load this
		     SDK's tasks through the environment the build passes on, and fail. -->
		<PropertyGroup>
			<_Dotnet Condition="'$(DOTNET_HOST_PATH)' != ''">&quot;$(DOTNET_HOST_PATH)&quot;</_Dotnet>
			<_Dotnet Condition="'$(DOTNET_HOST_PATH)' == ''">dotnet</_Dotnet>
		</PropertyGroup>
		<Exec Command="$(_Dotnet) publish &quot;$(_CliProject)&quot; -f net10.0 -r $(RuntimeIdentifier) --self-contained true -c $(Configuration) -p:TypedownWinUIPackaging=true -o &quot;$(_CliPublishDir)&quot; -nologo -v q" />
		<ItemGroup>
			<_CliFile Include="$(_CliPublishDir)\**\*" Exclude="$(_CliPublishDir)\**\*.pdb" />
			<_CliRelative Include="@(_CliFile->'%(RecursiveDir)%(Filename)%(Extension)')" Source="%(_CliFile.FullPath)" />
		</ItemGroup>
		<Error Condition="!Exists('$(_CliPublishDir)\$(BrandCliName).exe')" Text="$(BrandCliName) was not published for $(RuntimeIdentifier)." />
	</Target>
	<Target Name="PublishCliAlongside" AfterTargets="ComputeResolvedFilesToPublishList" DependsOnTargets="PublishCli"
	        Condition="'$(RuntimeIdentifier)' != '' and '$(AutomationTestHost)' != 'true' and '$(IncludeCli)' != 'false' and '$(WindowsPackageType)' != 'MSIX'">
		<ItemGroup>
			<_AppRelative Include="@(ResolvedFileToPublish->'%(RelativePath)')" />
			<_CliNew Include="@(_CliRelative)" Exclude="@(_AppRelative)" />
			<ResolvedFileToPublish Include="%(_CliNew.Source)" RelativePath="%(_CliNew.Identity)" CopyToPublishDirectory="PreserveNewest" />
		</ItemGroup>
		<Message Importance="high" Text="$(BrandCliName): @(_CliNew->Count()) file(s) published with the app" />
	</Target>
	<Target Name="PackageCliAlongside" AfterTargets="GetPackagingOutputs" BeforeTargets="_ComputeAppxPackagePayload" DependsOnTargets="PublishCli"
	        Condition="'$(RuntimeIdentifier)' != '' and '$(AutomationTestHost)' != 'true' and '$(IncludeCli)' != 'false' and '$(WindowsPackageType)' == 'MSIX'">
		<ItemGroup>
			<_AppPackaged Include="@(PackagingOutputs->'%(TargetPath)')" />
			<_CliNew Include="@(_CliRelative)" Exclude="@(_AppPackaged)" />
			<PackagingOutputs Include="%(_CliNew.Source)" TargetPath="%(_CliNew.Identity)" OutputGroup="CustomOutputGroupForPackaging" ProjectName="$(ProjectName)" />
		</ItemGroup>
		<Message Importance="high" Text="$(BrandCliName): @(_CliNew->Count()) file(s) put in the MSIX" />
	</Target>
</Project>
