<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows end-to-end driver (docs/automation-api-analysis-plan.md, 10.6/10.7). Run by run-windows-e2e.ps1 in
       the logged-on desktop session against the automation test host. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- UI Automation (answering the app's dialogs through their buttons); buildable on Linux too. -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Dev\Typedown.Automation\Typedown.Automation.csproj" />
    <!-- IU02 makes its bucket and reads the object back with the application's own signing. -->
    <Compile Include="..\..\..\Dev\Typedown.Core\Services\S3Uploader.cs" Link="S3Uploader.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- PF03: a CPU sample trace of the test host (EventPipe), summarized by the driver itself. -->
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.553101" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.19" />
  </ItemGroup>
</Project>
