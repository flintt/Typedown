<Project Sdk="Microsoft.NET.Sdk">
  <!-- typedownctl: the reference client of the local automation API (docs/automation-api-spec.md, section 3.5). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>typedownctl</AssemblyName>
    <RootNamespace>Typedown.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Dev\Typedown.Automation\Unix\UnixSocketListener.cs" Link="Unix\UnixSocketListener.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Dev\Typedown.Automation\Typedown.Automation.csproj" />
  </ItemGroup>
</Project>
