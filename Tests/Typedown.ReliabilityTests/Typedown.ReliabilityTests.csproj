<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="3.1.32" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.4" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="UTF.Unknown" Version="2.8.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile the production implementations rather than maintaining test copies. -->
    <Compile Include="../../Dev/Typedown.Core/Services/AutoBackup.cs" Link="Production/AutoBackup.cs" />
    <Compile Include="../../Dev/Typedown.Core/Services/JsonSettingsStore.cs" Link="Production/JsonSettingsStore.cs" />
    <Compile Include="../../Dev/Typedown.Core/Utilities/SafeFile.cs" Link="Production/SafeFile.cs" />
    <Compile Include="../../Dev/Typedown.Core/Utilities/SnapshotWriter.cs" Link="Production/SnapshotWriter.cs" />
    <Compile Include="../../Dev/Typedown.Core/Models/RuntimeModels/ContentHistory.cs" Link="Production/ContentHistory.cs" />
    <Compile Include="../../Dev/Typedown.Core/Models/RuntimeModels/CursorState.cs" Link="Production/CursorState.cs" />
    <Compile Include="../../Dev/Typedown.Core/Utilities/ThemeDesignerPage.cs" Link="Production/ThemeDesignerPage.cs" />
    <Compile Include="../../Dev/Typedown.Core/Utilities/WebView2Runtime.cs" Link="Production/WebView2Runtime.cs" />
    <Compile Include="../../Dev/Typedown.Core/Utilities/StartupTiming.cs" Link="Production/StartupTiming.cs" />
    <Compile Include="../../Dev/Typedown.Core/Utilities/LogText.cs" Link="Production/LogText.cs" />
    <Compile Include="../../Dev/Typedown.Core/Utilities/DiskConflict.cs" Link="Production/DiskConflict.cs" />
    <Compile Include="../../Dev/Typedown.Core/Utilities/ClipboardHtml.cs" Link="Production/ClipboardHtml.cs" />
    <Compile Include="../../Dev/Typedown.Core/Utilities/ImageData.cs" Link="Production/ImageData.cs" />
    <Compile Include="../../Dev/Typedown.Core/Utilities/FocusRule.cs" Link="Production/FocusRule.cs" />
    <Compile Include="../../Dev/Typedown.Core/Utilities/RecentPaths.cs" Link="Production/RecentPaths.cs" />
    <Compile Include="../../Dev/Typedown.Core/Utilities/TextFileFormat.cs" Link="Production/TextFileFormat.cs" />
    <Compile Include="../../Dev/Typedown.Core/Services/FavoritesStore.cs" Link="Production/FavoritesStore.cs" />
    <Compile Include="../../Dev/Typedown.Core/Services/FirstEditMutes.cs" Link="Production/FirstEditMutes.cs" />
    <Compile Include="../../Dev/Typedown.Core/Migrations/*.cs" Link="Production/Migrations/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures/*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
